<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/future_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
  <TextView android:id="@+id/future_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="未来倒计时" android:textColor="#B3FFFFFF" android:textSize="11sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/future_widget_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="58dp" android:maxLines="1" android:text="D-30" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
      <TextView android:id="@+id/future_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="添加一个目标" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"/>
      <TextView android:id="@+id/future_widget_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="把重要的日子放在眼前" android:textColor="#B3FFFFFF" android:textSize="11sp"/>
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/future_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="" android:textColor="#80FFFFFF" android:textSize="10sp"/>
</LinearLayout>
